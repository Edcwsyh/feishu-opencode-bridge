# ============================================
# 飞书 OpenCode 桥接服务 配置
# ============================================

# 飞书企业自建应用配置
# 在 https://open.feishu.cn/app 创建自建应用
# 1. 开启"机器人"能力
# 2. 开启"消息"权限（im:message, im:message:send_as_bot）
# 3. 订阅事件：接收消息 (im.message.receive_v1)
# 4. 启用"长连接"接收消息模式
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# OpenCode Server 配置
OPENCODE_SERVER_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=

# 服务端口
PORT=8080
HOST=0.0.0.0

# 日志配置
LOG_LEVEL=INFO
# 日志目录，默认 /tmp/$USER/feishu-opencode-bridge
LOG_DIR=
# 桥接服务日志文件名
BRIDGE_LOG_FILE=bridge.log
# OpenCode Server 日志文件名
OPENCODE_LOG_FILE=opencode.log
